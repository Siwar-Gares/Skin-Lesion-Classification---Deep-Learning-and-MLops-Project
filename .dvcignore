# DVC ignore patterns

# Large dataset files 
data/HAM10000_images_part_*
*.zip
*.tar.gz

# Model checkpoints (tracked selectively)
checkpoints/*.pth
!checkpoints/best_model.pth

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.sublime-*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# MLflow
mlruns/
mlartifacts/

# Logs
*.log
logs/

# Jupyter
.ipynb_checkpoints/
